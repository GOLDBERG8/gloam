{
  "name": "@gloamtrade/mcp",
  "mcpName": "io.github.cryptoduke01/gloam",
  "version": "0.3.4",
  "private": false,
  "type": "module",
  "description": "Gloam MCP server: private stablecoin payments for AI agents on Tempo and Robinhood Chain, live on mainnet (beta) with testnet for practice, under spending limits the agent cannot lift.",
  "license": "MIT",
  "homepage": "https://gloam.trade/docs/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoduke01/gloam.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/cryptoduke01/gloam/issues"
  },
  "keywords": [
    "gloam",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-payments",
    "x402",
    "tempo",
    "stablecoin",
    "payments",
    "privacy",
    "zero-knowledge",
    "access-keys",
    "spending-limits",
    "robinhood-chain"
  ],
  "bin": {
    "gloam-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/test-spend-limits.mts scripts/test-notes.mts scripts/test-access-key.mts scripts/test-mpp.mts scripts/test-mainnet.mts scripts/test-safe-fetch.mts scripts/test-wormhole.mts",
    "authorize-access-key": "tsx scripts/authorize-access-key.mts",
    "demo:tempo": "tsx scripts/demo-tempo-agent.mts",
    "verify:prover": "tsx scripts/verify-transfer-prover.mjs",
    "smoke": "node scripts/smoke-stdio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "circomlibjs": "0.1.7",
    "snarkjs": "^0.7.5",
    "undici": "^6.21.2",
    "viem": "^2.55.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@gloamtrade/mppx-gloam": "workspace:*",
    "@gloamtrade/sdk": "workspace:*",
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "tsx": "^4",
    "typescript": "^5"
  }
}
