# ── Optional overrides only ──────────────────────────────────────────
# App defaults are hard-coded for Robinhood testnet (46630):
#   Poseidon pool (sealed) 0x4F38…2D8F @ block 90436718
#   GloamPayMemo           0x689e…5DCE @ block 90421567
#
# You do NOT need these on Vercel for testnet to work.
# Set only if you redeploy contracts or point at a fork.
#
# DO NOT set NEXT_PUBLIC_POSEIDON_SHIELD_POOL to 0xA488… (pre-sealed vault).
# The app remaps that stale address to 0x4F38… automatically.

# NEXT_PUBLIC_POSEIDON_SHIELD_POOL=0x4F38a4d80e5ca516A2e5549404C7be0E91c12D8F
# NEXT_PUBLIC_HASH_SCHEME=poseidon
# NEXT_PUBLIC_SHIELD_DEPLOY_BLOCK=90436718
# NEXT_PUBLIC_PAY_MEMO=0x689ebd9d30E0235c73fd8f10236F850CDB3c5DCE
# NEXT_PUBLIC_PAY_MEMO_DEPLOY_BLOCK=90421567

# Legacy keccak pool (no private trade):
# NEXT_PUBLIC_HASH_SCHEME=keccak
# NEXT_PUBLIC_SHIELD_POOL_ADDRESS=0x2BD98196D90AB45D58843B4c8B8809aa34343d35

# ── Turnkey embedded wallets (passkey / email login) ─────────────────
# Get both from the Turnkey dashboard:
#   Organization ID      -> top-right account menu / Organization settings
#   Auth Proxy Config ID -> Embedded Wallets > Configuration (after enabling auth methods)
# Until BOTH are set, the app falls back to normal wallet connect (nothing breaks).
# NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
# NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=

# Optional: Discord/Slack/Make webhook for product events (server only)
# TRACTION_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Admin traction dashboard (/admin) ────────────────────────────────
# Required in production (server-only — never NEXT_PUBLIC_):
# ADMIN_ACCESS_CODE=long-random-secret
# Dev default if unset: gloam-dev-admin
# If cookies fail on a weird HTTPS setup: ADMIN_COOKIE_INSECURE=true
#
# Durable product-event store (recommended free Upstash Redis):
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=…

# ── Gloam relay (hides the sender's wallet on private sends + cash outs) ──
# Server-only key for a FRESH, testnet-only account that just pays gas.
# It never holds user money (proofs authorize spends; cash-out recipients are
# bound inside the proof). Fund it from the faucets:
#   Tempo:     it needs PathUSD for fees (tempo_fundAddress faucet)
#   Robinhood: it needs testnet ETH
# Unset = relay off; the app falls back to "send from your wallet".
# GLOAM_RELAYER_PRIVATE_KEY=

# ── Payment messages on Tempo (lets Gloam-address payees find payments) ──
# Live default: 0x3ca88712e9219b5EE4c82D31cAfEaB64C9E9b4E3 @ block 37410900.
# Override only if you redeploy it:
# NEXT_PUBLIC_PAY_MEMO_TEMPO=0x...
# NEXT_PUBLIC_PAY_MEMO_TEMPO_DEPLOY_BLOCK=

# ── Partner portal + Gloam API v1 (/partners, /api/v1) ──
# Server-only. Hashes API keys and signs partner sessions. At least 32 chars;
# never rotate it once keys exist (every issued key stops working).
#   openssl rand -hex 32
# GLOAM_API_KEY_PEPPER=
# Optional: a separate secret for partner sessions (defaults to one derived
# from the pepper). Rotating it signs every partner out.
# GLOAM_PARTNER_SESSION_SECRET=
# Optional: hosts a sign-in message may name (defaults to the request host).
# GLOAM_PARTNER_DOMAINS=gloam.trade,www.gloam.trade
# Partners and keys live in the Upstash Redis above. Local tests only:
# GLOAM_PARTNERS_STORE=memory

# Recording demo (?demo=1): on by default only on localhost. Set to 1 to allow it on a deployment.
# NEXT_PUBLIC_GLOAM_DEMO=1

# ── Testers program (/testers) ──
# The private Telegram group's join-request link. Shown only after someone
# applies, so the form stays the way in. Unset: applicants are told the invite
# comes on Telegram. Applications live in the Upstash Redis above.
# GLOAM_TESTERS_TELEGRAM_URL=https://t.me/+...
# Paid tester spots (default 31). Later applicants are kept as unpaid volunteers.
# GLOAM_TESTERS_CAP=31

# ── Telegram helper bot (/api/telegram, the t.me/gloamhq group) ──
# Server only. Setup steps are at the top of src/app/api/telegram/route.ts.
# Bot token from BotFather, and a long random secret Telegram sends back on
# every webhook call (A-Z, a-z, 0-9, _ and - only). Register the webhook with
#   TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=... node app/scripts/telegram-webhook.mjs
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Writes replies with the Anthropic API. Unset: the bot only sends its fixed replies.
# ANTHROPIC_API_KEY=
# Optional. Defaults shown. claude-haiku-5-5 is the cheaper model.
# TELEGRAM_BOT_MODEL=claude-sonnet-5-5
# TELEGRAM_BOT_PERSONA=Glim
# Model calls per UTC day, for everyone together (defaults shown; 0 turns that
# kind off). Past a cap the bot sends only its fixed replies until the day turns.
# Also set a monthly spend limit in the Anthropic console.
# TELEGRAM_BOT_DAILY_ANSWERS=800
# TELEGRAM_BOT_DAILY_CHECKS=1500
# Replies in the owner's and admins' private chats with the bot, on their own cap.
# TELEGRAM_BOT_DAILY_DMS=200
# TELEGRAM_GROUP_ID=-1004464028206
# Admins, comma separated: the bot names them when something needs a person, and
# they can chat with it in private. Ids are safer (handles can change hands).
# TELEGRAM_ADMIN_HANDLES=
# TELEGRAM_ADMIN_IDS=
# Set to true when group testing starts; until then the bot says it starts soon.
# GLOAM_TESTING_OPEN=false
# In private the bot answers only the owner and the admins: both can chat with
# it, and the owner also gets reports (/report). Everyone else gets silence.
# Handles match without case; numeric owner ids win when set, since handles
# can change.
# TELEGRAM_OWNER_HANDLES=dukedotsol
# TELEGRAM_OWNER_IDS=
# Daily report to the owner at 21:00 WAT, sent by the Vercel cron in
# vercel.json. Off unless true; the owner must have messaged the bot once.
# Vercel sends CRON_SECRET as a Bearer token, so set it too.
# TELEGRAM_DAILY_REPORT=false
# CRON_SECRET=
# Memory, counters, welcomes and bug reports live in the Upstash Redis above.
