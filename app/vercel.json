{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && pnpm install",
  "buildCommand": "pnpm run build",
  "crons": [
    {
      "path": "/api/telegram/report",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/telegram/buys",
      "schedule": "* * * * *"
    }
  ]
}
