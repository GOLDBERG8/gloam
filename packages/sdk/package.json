{
  "name": "@gloamtrade/sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Gloam SDK: shielded balances, private payments, and selective disclosure on Robinhood Chain and Tempo. The private path other apps and agents plug into.",
  "license": "MIT",
  "homepage": "https://gloam.trade/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoduke01/gloam.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/cryptoduke01/gloam/issues"
  },
  "keywords": [
    "gloam",
    "robinhood-chain",
    "tempo",
    "stablecoin",
    "payments",
    "privacy",
    "zero-knowledge",
    "zk",
    "groth16",
    "poseidon",
    "shielded",
    "defi",
    "arbitrum-orbit",
    "sdk"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node test/rates.selftest.mjs && node test/note.selftest.mjs && node test/witness.selftest.mjs && node test/proofs.selftest.mjs && node test/intents.selftest.mjs && node test/sync.selftest.mjs && node test/x402.selftest.mjs && node test/x402.edge.selftest.mjs && node test/receiveTag.selftest.mjs && node test/sweep.selftest.mjs && node test/api.selftest.mjs && node test/mainnet.selftest.mjs"
  },
  "dependencies": {
    "viem": "^2.55.2",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "snarkjs": "^0.7.5"
  },
  "peerDependencies": {
    "snarkjs": "*"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    }
  }
}
