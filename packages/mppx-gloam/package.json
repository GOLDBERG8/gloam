{
  "name": "@gloamtrade/mppx-gloam",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Private payments for the Machine Payments Protocol (MPP). The \"gloam\" payment method for mppx: a charge settles as a shielded transfer through the Gloam pool, sealed to the payee's receive tag and swept before access, so the public sees a shielded transfer and nothing else.",
  "license": "MIT",
  "homepage": "https://gloam.trade/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoduke01/gloam.git",
    "directory": "packages/mppx-gloam"
  },
  "bugs": {
    "url": "https://github.com/cryptoduke01/gloam/issues"
  },
  "keywords": [
    "mpp",
    "mppx",
    "machine-payments-protocol",
    "http-402",
    "payment-auth",
    "gloam",
    "tempo",
    "stablecoin",
    "privacy",
    "zero-knowledge",
    "agents"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./server": {
      "types": "./src/mppx/server.ts",
      "default": "./src/mppx/server.ts"
    },
    "./client": {
      "types": "./src/mppx/client.ts",
      "default": "./src/mppx/client.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./server": {
        "types": "./dist/mppx/server.d.ts",
        "default": "./dist/mppx/server.js"
      },
      "./client": {
        "types": "./dist/mppx/client.d.ts",
        "default": "./dist/mppx/client.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@gloamtrade/sdk": "workspace:*",
    "viem": "^2.55.2"
  },
  "peerDependencies": {
    "mppx": ">=0.13.1"
  },
  "peerDependenciesMeta": {
    "mppx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "mppx": "^0.13.1",
    "tsx": "^4",
    "typescript": "^5"
  }
}
